# ========== 短信服务配置 ==========
# 当前模式: console (控制台打印，不实际发送)
# 设置以下任一项即可发送真实短信

# ==== 阿里云短信 (推荐) ====
# 1. 登录 https://dysms.console.aliyun.com
# 2. 获取 AccessKey: https://ram.console.aliyun.com
# 3. 创建短信模板
# SMS_PROVIDER=aliyun
# SMS_ALIYUN_ACCESS_KEY=LTAI5t...
# SMS_ALIYUN_SECRET_KEY=your_secret
# SMS_ALIYUN_SIGN_NAME=郭子论坛
# SMS_ALIYUN_TEMPLATE_CODE=SMS_123456789

# ==== 腾讯云短信 ====
# SMS_PROVIDER=tencent
# SMS_TENCENT_SECRET_ID=AKID...
# SMS_TENCENT_SECRET_KEY=your_key
# SMS_TENCENT_SDK_APP_ID=1400...
# SMS_TENCENT_SIGN=郭子论坛
# SMS_TENCENT_TEMPLATE_ID=1234567

# ==== 通用HTTP接口 ====
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://api.example.com/sms?phone={phone}&code={code}
